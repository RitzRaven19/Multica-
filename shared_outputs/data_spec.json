  "state_transitions": {
    "Account": {
      "valid_states": ["PENDING", "ACTIVE", "FROZEN", "CLOSED"],
      "transitions": [
        { "from": "PENDING", "to": "ACTIVE", "trigger": "Bank operations review & activation", "actor": "Bank operations" },
        { "from": "PENDING", "to": "CLOSED", "trigger": "Bank operations rejection", "actor": "Bank operations" },
        { "from": "ACTIVE", "to": "FROZEN", "trigger": "Bank operations freeze", "actor": "Bank operations" },
        { "from": "FROZEN", "to": "ACTIVE", "trigger": "Bank operations un-freeze", "actor": "Bank operations" }
      ]
    },
    "Transaction": {
      "valid_states": ["PENDING", "SUCCESS", "FAILED"],
      "transitions": [
        { "from": "PENDING", "to": "SUCCESS", "trigger": "Transfer validated and settled (limits satisfied and funds available)", "actor": "system" },
        { "from": "PENDING", "to": "FAILED", "trigger": "Validation failure (insufficient balance, over daily cap, or invalid destination)", "actor": "system" }
      ]
    },
    "KYC Record": {
      "valid_states": ["PENDING", "VERIFIED", "REJECTED"],
      "transitions": [
        { "from": "PENDING", "to": "VERIFIED", "trigger": "Bank operations KYC review passes", "actor": "Bank operations" },
        { "from": "PENDING", "to": "REJECTED", "trigger": "Bank operations KYC review rejects", "actor": "Bank operations" }
      ]
    },
    "Session": {
      "valid_states": ["ACTIVE", "EXPIRED", "TERMINATED"],
      "transitions": [
        { "from": "ACTIVE", "to": "TERMINATED", "trigger": "User logs out", "actor": "system" },
        { "from": "ACTIVE", "to": "EXPIRED", "trigger": "Session timeout", "actor": "system" }
      ]
    },
    "Customer": {
      "valid_states": ["REGISTERED"],
      "transitions": []
    }
  },

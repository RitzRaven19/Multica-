  "limit_placeholders": [
    {
      "name": "minimum_balance",
      "open_question_id": "OQ-001",
      "boundary_values": {
        "below": "balance ends below minimum balance -> to proceed requires deposit; transfer rejected",
        "at": "balance at exactly minimum balance -> transfer of zero net allowed, no further debit permitted",
        "above": "balance above minimum balance -> transfer permitted up to available balance"
      },
      "error_id": "ERR-009"
    },
    {
      "name": "daily_transfer_cap",
      "open_question_id": "OQ-002",
      "boundary_values": {
        "below": "cumulative transfers below daily cap -> permitted",
        "at": "cumulative transfers at exactly daily cap -> permitted",
        "above": "cumulative transfers exceed daily cap -> rejected"
      },
      "error_id": "ERR-010"
    }
